      "outputs": [],
      "source": [
        "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "print(\"5-Fold Stratified Cross-Validation Results:\")\n",
        "print(\"=\" * 45)\n",
        "\n",
        "for name, model, X_data in [\n",
        "    ('Gaussian NB',    GaussianNB(),    X_train_scaled),\n",
        "    ('Multinomial NB', MultinomialNB(), X_train_mm),\n",
        "    ('Bernoulli NB',   BernoulliNB(),   X_train_bin),\n",
        "]:\n",
        "    scores = cross_val_score(model, X_data, y_train, cv=skf, scoring='accuracy')\n",
        "    print(f\"\\n{name}:\")\n",
        "    for i, s in enumerate(scores, 1):\n",
        "        print(f\"  Fold {i}: {s:.4f}\")\n",
        "    print(f\"  Mean : {scores.mean():.4f} ± {scores.std():.4f}\")"
      ]
